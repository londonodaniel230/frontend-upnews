import { useState, type ReactNode } from 'react';
import asiscoLogo from './imports/imgdownloader-1a6f7e48.png';

type Page = 'inicio' | 'noticia' | 'agenda' | 'proyectos' | 'nosotros' | 'publicar' | 'login';

const events = [
  { day: '24', month: 'OCT', title: 'Feria de panadería', time: '10:00 a. m.', place: 'Sede de la fundación' },
  { day: '14', month: 'NOV', title: 'Muestra de música para las familias', time: '3:00 p. m.', place: 'Auditorio principal' },
  { day: '5', month: 'DIC', title: 'Novena con padrinos y familias', time: '4:00 p. m.', place: 'Casa ASISCO UP' },
];

const news = [
  {
    category: 'Talleres',
    title: 'Taller: los jóvenes hornean sus primeras recetas',
    excerpt: 'Una jornada para aprender, compartir y fortalecer la autonomía.',
    art: 'screen',
    tone: 'orange',
  },
  {
    category: 'La Fundación',
    title: 'Abrimos inscripciones para el taller de panadería',
    excerpt: 'Conoce cómo participar en nuestros próximos espacios de formación.',
    art: 'bread',
    tone: 'cream',
  },
  {
    category: 'Comunidad',
    title: 'Cada corazón cuenta una historia',
    excerpt: 'Celebramos el acompañamiento de las familias de nuestra comunidad.',
    art: 'heart',
    tone: 'green',
  },
];

function Icon({ name, size = 18 }: { name: 'search' | 'send' | 'heart' | 'menu' | 'close' | 'arrow' | 'calendar' | 'clock' | 'pin' | 'volume' | 'check' | 'edit' | 'lock'; size?: number }) {
  const paths: Record<typeof name, ReactNode> = {
    search: <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>,
    send: <><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></>,
    heart: <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />,
    menu: <><path d="M4 7h16M4 12h16M4 17h16" /></>,
    close: <><path d="m6 6 12 12M18 6 6 18" /></>,
    arrow: <><path d="M5 12h14M13 6l6 6-6 6" /></>,
    calendar: <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></>,
    clock: <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>,
    pin: <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2" /></>,
    volume: <><path d="M11 5 6 9H2v6h4l5 4Z" /><path d="M15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12" /></>,
    check: <path d="m5 12 4 4L19 6" />,
    edit: <><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" /></>,
    lock: <><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></>,
  };
  return <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">{paths[name]}</svg>;
}

function Brand({ light = false }: { light?: boolean }) {
  return (
    <button className="brand" aria-label="Ir al inicio">
      <img src={asiscoLogo} alt="ASISCO" />
      <span className={light ? 'light' : ''}>UPNEWS</span>
    </button>
  );
}

function DrumArt({ compact = false }: { compact?: boolean }) {
  return (
    <svg className="illustration" viewBox="0 0 560 300" role="img" aria-label="Ilustración de un tambor y notas musicales">
      <rect width="560" height="300" rx="28" fill="#17645e" />
      <circle cx="476" cy="54" r="72" fill="#2b756e" />
      <circle cx="95" cy="264" r="95" fill="#205f5a" />
      <path d="M217 111 319 91l-17 25-92 18Z" fill="#f4b249" />
      <path d="M210 133h92l-8 91c-1 12-18 22-40 22s-40-10-41-22Z" fill="#ef9417" stroke="#fff7df" strokeWidth="7" />
      <ellipse cx="256" cy="132" rx="47" ry="14" fill="#fff7df" />
      <ellipse cx="256" cy="132" rx="37" ry="9" fill="#d67d16" />
      <path d="m215 156 79 58M297 156l-80 58" stroke="#fff7df" strokeWidth="7" />
      <path d="m205 121-39-66M303 111l45-67" stroke="#fff7df" strokeWidth="8" strokeLinecap="round" />
      <circle cx="164" cy="51" r="10" fill="#ef9417" />
      <circle cx="351" cy="42" r="10" fill="#ef9417" />
      <g fill="#fff7df">
        <path d="M115 92v48c-24-4-30 23-9 25 17 2 23-10 23-23V99l26-8v34c-22-3-27 21-8 24 15 2 22-9 22-22V70Z" />
        <path d="M407 75v55c-24-4-31 23-9 26 17 2 23-11 23-23V82l28-8v38c-21-3-27 21-8 24 15 2 22-9 22-22V52Z" />
      </g>
      {!compact && <><circle cx="460" cy="223" r="8" fill="#ef9417" /><circle cx="90" cy="70" r="7" fill="#f4b249" /></>}
    </svg>
  );
}

function StoryArt({ type }: { type: string }) {
  if (type === 'bread') {
    return (
      <svg className="illustration" viewBox="0 0 380 210" role="img" aria-label="Ilustración de panes">
        <rect width="380" height="210" fill="#f5dfb7" />
        <path d="M55 163c13-72 95-97 145-39 48-66 129-25 126 39Z" fill="#dc9d51" />
        <path d="m101 129 22 22m15-43 23 25m82-25-23 27m67-8-29 28" stroke="#f9edcf" strokeWidth="9" strokeLinecap="round" />
        <path d="M28 174h324" stroke="#23635d" strokeWidth="9" strokeLinecap="round" />
        <path d="M286 38v49m-22-26 22 26 23-29m-23-2 30-23" stroke="#259a92" strokeWidth="7" strokeLinecap="round" />
        <circle cx="286" cy="31" r="9" fill="#f19700" />
      </svg>
    );
  }
  if (type === 'heart') {
    return (
      <svg className="illustration" viewBox="0 0 380 210" role="img" aria-label="Ilustración de un corazón">
        <rect width="380" height="210" fill="#17645e" />
        <path d="M191 168S91 113 116 66c18-34 61-24 75 6 14-30 57-40 75-6 25 47-75 102-75 102Z" fill="#f19700" />
        <g fill="#fff7df"><circle cx="63" cy="55" r="9" /><circle cx="319" cy="76" r="7" /><path d="m62 102 4 11 11 4-11 4-4 11-4-11-11-4 11-4Z" /><path d="m318 122 4 10 10 4-10 4-4 10-4-10-10-4 10-4Z" /></g>
      </svg>
    );
  }
  return (
    <svg className="illustration" viewBox="0 0 380 210" role="img" aria-label="Ilustración de un taller audiovisual">
      <rect width="380" height="210" fill="#f6b13f" />
      <rect x="80" y="45" width="205" height="123" rx="10" fill="#fff7df" stroke="#23635d" strokeWidth="8" />
      <rect x="100" y="64" width="118" height="82" rx="4" fill="#259a92" />
      <circle cx="159" cy="93" r="18" fill="#f8d9a5" />
      <path d="M124 140c7-31 63-31 70 0" fill="#23635d" />
      <path d="m238 82 34-19v67l-34-17Z" fill="#23635d" />
      <circle cx="312" cy="51" r="15" fill="#fff7df" /><path d="m307 51 5 5 9-11" fill="none" stroke="#23635d" strokeWidth="5" />
    </svg>
  );
}

function Header({ page, onNavigate }: { page: Page; onNavigate: (page: Page) => void }) {
  const [open, setOpen] = useState(false);
  const go = (next: Page) => { onNavigate(next); setOpen(false); window.scrollTo({ top: 0, behavior: 'smooth' }); };
  return (
    <header className="site-header">
      <div className="header-inner">
        <div onClick={() => go('inicio')}><Brand /></div>
        <nav className={open ? 'main-nav open' : 'main-nav'} aria-label="Navegación principal">
          <button className={page === 'inicio' ? 'active' : ''} onClick={() => go('inicio')}>Inicio</button>
          <button className={page === 'noticia' ? 'active' : ''} onClick={() => go('noticia')}>Noticias</button>
          <button className={page === 'agenda' ? 'active' : ''} onClick={() => go('agenda')}>Agenda</button>
          <button className={page === 'proyectos' ? 'active' : ''} onClick={() => go('proyectos')}>Proyectos</button>
          <button className={page === 'nosotros' ? 'active' : ''} onClick={() => go('nosotros')}>¿Quiénes somos?</button>
          <button className="nav-donate" onClick={() => { setOpen(false); document.getElementById('donar')?.scrollIntoView({ behavior: 'smooth' }); }}><Icon name="heart" size={14} /> Donar</button>
        </nav>
        <div className="header-actions">
          <button className="search-button" aria-label="Buscar noticias"><Icon name="search" size={16} /><span>Buscar noticias</span></button>
          <a className="button secondary desktop-action" href="https://t.me/" target="_blank" rel="noreferrer"><Icon name="send" size={15} /> Telegram</a>
          <button className="admin-access" aria-label="Acceso administrativo" title="Acceso administrativo" onClick={() => go('login')}><Icon name="lock" size={14} /><span>Acceso</span></button>
          <button className="menu-button" onClick={() => setOpen(!open)} aria-label={open ? 'Cerrar menú' : 'Abrir menú'}><Icon name={open ? 'close' : 'menu'} /></button>
        </div>
      </div>
    </header>
  );
}

function SectionTitle({ title, action }: { title: string; action?: string }) {
  return <div className="section-title"><h2>{title}</h2>{action && <button>{action} <Icon name="arrow" size={15} /></button>}</div>;
}

function EventDate({ day, month }: { day: string; month: string }) {
  return <div className="event-date"><strong>{day}</strong><span>{month}</span></div>;
}

function EventRow({ event, featured = false }: { event: typeof events[number]; featured?: boolean }) {
  return (
    <article className={featured ? 'event-row featured' : 'event-row'}>
      <EventDate day={event.day} month={event.month} />
      <div className="event-copy"><h3>{event.title}</h3><p><Icon name="clock" size={13} /> {event.time} · {event.place}</p></div>
      <button className={featured ? 'pill filled' : 'pill'}>{featured ? 'Inscribirme' : 'Ver detalle'}</button>
    </article>
  );
}

function Home({ onNavigate }: { onNavigate: (page: Page) => void }) {
  return (
    <>
      <main>
        <section className="hero shell">
          <div className="hero-copy">
            <span className="eyebrow">Historias · 10 oct</span>
            <h1>El grupo de música prepara su primera muestra para las familias</h1>
            <p>Una historia sobre aprendizaje, confianza y el poder de crear juntos en nuestra fundación.</p>
            <div className="hero-buttons">
              <button className="button orange" onClick={() => onNavigate('noticia')}>Leer noticia <Icon name="arrow" size={16} /></button>
              <button className="button ghost-light"><Icon name="volume" size={16} /> Escuchar noticia</button>
            </div>
          </div>
          <div className="hero-art"><DrumArt /></div>
        </section>

        <section className="shell section">
          <SectionTitle title="Próximos eventos" action="Ver agenda" />
          <div className="events-preview">
            {events.map((event, index) => <EventRow key={event.title} event={event} featured={index === 1} />)}
          </div>
        </section>

        <section className="shell section news-section">
          <SectionTitle title="Últimas noticias" action="Ver todas" />
          <div className="filters" aria-label="Filtrar noticias">
            {['Todas', 'Talleres', 'Eventos', 'La Fundación'].map((filter, index) => <button className={index === 0 ? 'active' : ''} key={filter}>{filter}</button>)}
          </div>
          <div className="news-grid">
            {news.map((item) => (
              <article className="news-card" key={item.title} onClick={() => onNavigate('noticia')}>
                <div className={`news-art ${item.tone}`}><StoryArt type={item.art} /></div>
                <div className="news-card-body"><span>{item.category} · 8 oct</span><h3>{item.title}</h3><p>{item.excerpt}</p><button>Leer noticia <Icon name="arrow" size={14} /></button></div>
              </article>
            ))}
          </div>
        </section>

        <section className="shell support-grid">
          <div className="telegram-band">
            <div className="round-icon"><Icon name="send" size={24} /></div>
            <div><span>Las noticias de la fundación, en tu Telegram</span><p>Recibe nuestras historias y eventos.</p></div>
            <a className="button light" href="https://t.me/" target="_blank" rel="noreferrer">Unirme al canal</a>
          </div>
          <div className="donation-band" id="donar">
            <div className="round-icon"><Icon name="heart" size={24} /></div>
            <div><span>¿Quieres apoyar nuestra labor?</span><p>Tu aporte abre nuevas oportunidades.</p></div>
            <button className="button dark">Donar con Asisco Pay</button>
          </div>
        </section>
      </main>
      <Footer onNavigate={onNavigate} />
    </>
  );
}

function ArticlePage() {
  return (
    <main className="shell article-layout">
      <article className="article">
        <span className="eyebrow dark">Historias · 10 oct</span>
        <h1>El grupo de música prepara su primera muestra para las familias</h1>
        <p className="lead">Con alegría y mucha práctica, el grupo de música de ASISCO UP se prepara para compartir lo aprendido con sus familias.</p>
        <div className="article-actions"><button className="button secondary"><Icon name="volume" size={16} /> Escuchar noticia</button><button className="plain-button">Lectura fácil</button></div>
        <DrumArt />
        <p>Cada sábado, el salón de música se llena de ritmos, instrumentos y sonrisas. Durante las últimas semanas el grupo ha preparado una muestra sencilla para compartir con las personas que han acompañado su proceso.</p>
        <p>La actividad hace parte de un proceso en el que cada participante reconoce sus capacidades, practica la escucha y aprende a trabajar con otros. La presentación será un espacio cercano, pensado para celebrar el esfuerzo de todo el grupo.</p>
        <h2>Una muestra construida entre todos</h2>
        <p>Las familias podrán acompañar el encuentro y conocer de primera mano lo que sucede en el taller. Próximamente publicaremos la fecha y las recomendaciones para asistir.</p>
        <div className="article-tags"><span>Música</span><span>Familias</span><span>Historias</span></div>
      </article>
      <aside className="article-aside">
        <div className="aside-card orange-card"><strong>¿Quieres apoyar nuestros talleres?</strong><p>Tu donación ayuda a mantener espacios de aprendizaje y encuentro.</p><button className="button light">Donar con Asisco Pay</button></div>
        <div className="aside-card teal-card"><strong>¿Quieres recibir esta noticia?</strong><p>Únete al canal oficial de la fundación.</p><a className="button light" href="https://t.me/" target="_blank" rel="noreferrer"><Icon name="send" size={15} /> Ir a Telegram</a></div>
        <div className="aside-card"><strong>También te puede interesar</strong>{news.slice(0, 2).map(item => <div className="mini-story" key={item.title}><StoryArt type={item.art} /><span>{item.title}</span></div>)}</div>
      </aside>
    </main>
  );
}

function AgendaPage() {
  const [selected, setSelected] = useState(1);
  return (
    <main className="agenda-page">
      <div className="shell">
        <h1 className="page-title">Agenda</h1>
        <div className="month-selector"><button>‹</button><span>Octubre y noviembre de 2026</span><button>›</button></div>
        <div className="agenda-layout">
          <div className="agenda-list">
            {events.map((event, index) => <div onClick={() => setSelected(index)} key={event.title}><EventRow event={event} featured={selected === index} /></div>)}
          </div>
          <aside className="event-detail">
            <DrumArt compact />
            <span className="eyebrow dark">Inscripciones abiertas</span>
            <h2>{events[selected].title}</h2>
            <p><Icon name="calendar" size={15} /> {events[selected].day} de {events[selected].month === 'NOV' ? 'noviembre' : events[selected].month === 'DIC' ? 'diciembre' : 'octubre'} de 2026</p>
            <p><Icon name="clock" size={15} /> {events[selected].time}</p>
            <label>Nombre completo<input placeholder="Escribe tu nombre" /></label>
            <label>Celular<input placeholder="Tu número de contacto" /></label>
            <fieldset><legend>¿Quiénes piensan asistir?</legend><div className="counter"><button>−</button><strong>2</strong><button>+</button><span>personas</span></div></fieldset>
            <div className="share-buttons"><button className="pill"><Icon name="send" size={14} /> WhatsApp</button><button className="pill"><Icon name="send" size={14} /> Telegram</button></div>
            <button className="button primary full">Confirmar inscripción</button>
            <small>La fundación confirmará tu cupo por teléfono.</small>
          </aside>
        </div>
      </div>
    </main>
  );
}

function ProjectsPage() {
  const projects = [
    ['Método Consuelo', 'Acompañamiento educativo que reconoce las capacidades y el ritmo de cada persona.'],
    ['Aula UP', 'Espacios para aprender, crear y fortalecer habilidades para la vida.'],
    ['SAGA-UP', 'Acompañamiento seguro para las familias y los procesos de cada participante.'],
    ['SON UP', 'Música, expresión y trabajo en equipo para nuestra comunidad.'],
  ];
  return (
    <main className="shell content-page"><span className="eyebrow dark">Lo que hacemos</span><h1 className="page-title">Proyectos que crecen con la comunidad</h1><p className="lead narrow">Estos son los proyectos reales que desarrolla ASISCO UP. Cada uno nace del acompañamiento a personas con síndrome de Down y sus familias.</p><div className="project-grid">{projects.map(([name, copy], i) => <article key={name}><span>0{i + 1}</span><h2>{name}</h2><p>{copy}</p><button>Conocer el proyecto <Icon name="arrow" size={14} /></button></article>)}</div></main>
  );
}

function AboutPage() {
  return (
    <main className="shell content-page about-page">
      <div><span className="eyebrow dark">Fundación ASISCO UP</span><h1 className="page-title">Una comunidad que acompaña capacidades</h1><p className="lead">Trabajamos en Manizales junto a personas con síndrome de Down, sus familias y una red de profesionales comprometidos con la inclusión.</p><p>Nuestro portal cuenta historias y abre espacios de participación. La información privada de los participantes se gestiona únicamente en las plataformas autorizadas de la fundación.</p></div>
      <div className="about-art"><StoryArt type="heart" /></div>
    </main>
  );
}

function LoginPage({ onBack }: { onBack: () => void }) {
  const [showMessage, setShowMessage] = useState(false);

  return (
    <main className="login-page">
      <section className="login-shell">
        <div className="login-intro">
          <div className="login-lock"><Icon name="lock" size={25} /></div>
          <span className="eyebrow">Área privada</span>
          <h1>Acceso para administradores</h1>
          <p>Este espacio es exclusivo para el equipo autorizado de la Fundación ASISCO UP.</p>
          <div className="login-note">
            <Icon name="check" size={16} />
            <span>Desde aquí el equipo puede preparar, revisar y publicar las noticias del portal.</span>
          </div>
        </div>

        <div className="login-card">
          <div className="login-card-head">
            <Brand />
            <span>Administración</span>
          </div>
          <h2>Iniciar sesión</h2>
          <p>Ingresa con las credenciales asignadas por la fundación.</p>
          <form onSubmit={(event) => { event.preventDefault(); setShowMessage(true); }}>
            <label>
              Correo electrónico
              <input type="email" placeholder="Ingresa tu correo electrónico" required />
            </label>
            <label>
              Contraseña
              <input type="password" placeholder="Tu contraseña" required />
            </label>
            <div className="login-options">
              <label><input type="checkbox" /> Recordar este equipo</label>
              <button type="button">¿Olvidaste tu contraseña?</button>
            </div>
            <button className="button primary full" type="submit"><Icon name="lock" size={15} /> Ingresar al panel</button>
          </form>
          {showMessage && <div className="login-feedback">La validación de credenciales estará disponible en la versión conectada del portal.</div>}
          <button className="back-link" onClick={onBack}>← Volver a UpNews</button>
          <small>Acceso restringido. Si no perteneces al equipo administrativo, vuelve al portal público.</small>
        </div>
      </section>
    </main>
  );
}

function PublishPage() {
  const [saved, setSaved] = useState(false);
  return (
    <main className="publisher">
      <div className="publisher-head"><div><Brand /><h1><Icon name="edit" size={19} /> Nueva noticia</h1></div><div><span className="status">Borrador</span><button className="pill">Vista previa</button><button className="button secondary" onClick={() => setSaved(true)}>Guardar borrador</button><button className="button primary" onClick={() => setSaved(true)}>Enviar a revisión</button></div></div>
      {saved && <div className="save-notice"><Icon name="check" size={16} /> Los cambios se guardaron correctamente.</div>}
      <div className="publisher-grid">
        <section className="editor-card">
          <label>Título <input defaultValue="El grupo de música prepara su primera muestra para las familias" /></label>
          <div className="field-group"><span>Categoría</span><div className="chip-row">{['Historias', 'Talleres', 'Eventos', 'La Fundación'].map((x, i) => <button className={i === 0 ? 'selected' : ''} key={x}>{x}</button>)}</div></div>
          <label>Resumen<textarea defaultValue="Una historia sobre aprendizaje, confianza y el poder de crear juntos en nuestra fundación." /></label>
          <label>Noticia completa<textarea className="article-input" defaultValue={'Cada sábado, el salón de música se llena de ritmos, instrumentos y sonrisas.\\n\\nLa próxima muestra será un espacio para celebrar el esfuerzo del grupo junto a sus familias.'} /></label>
          <div className="photo-field"><DrumArt compact /><div><strong>Ilustración de portada</strong><p>Sin fotos de banco. Usa material autorizado o una ilustración editorial.</p><button className="pill">Cambiar portada</button></div></div>
          <div className="warning">Antes de publicar, confirma la autorización de uso de imagen de todas las personas que aparezcan.</div>
        </section>
        <aside className="publisher-side">
          <div className="editor-card"><h2>Dónde se publica</h2><label className="check-row"><input type="checkbox" defaultChecked /> Portal UpNews</label><label className="check-row"><input type="checkbox" defaultChecked /> Canal de Telegram</label><div className="schedule"><button className="pill filled">Al aprobarla</button><button className="pill">Programar</button></div></div>
          <div className="editor-card preview"><h2>Así se verá en Telegram</h2><DrumArt compact /><strong>El grupo de música prepara su primera muestra para las familias</strong><p>Una historia sobre aprendizaje, confianza y el poder de crear juntos.</p></div>
        </aside>
      </div>
    </main>
  );
}

function Footer({ onNavigate }: { onNavigate: (page: Page) => void }) {
  return (
    <footer>
      <div className="shell footer-grid">
        <div><Brand light /><p>Noticias y actividades de la Fundación ASISCO UP en Manizales.</p></div>
        <div><strong>Proyectos</strong><button onClick={() => onNavigate('proyectos')}>Método Consuelo</button><button onClick={() => onNavigate('proyectos')}>Aula UP</button><button onClick={() => onNavigate('proyectos')}>SAGA-UP · SON UP</button></div>
        <div><strong>Participa</strong><button onClick={() => onNavigate('agenda')}>Agenda</button><a href="https://t.me/" target="_blank" rel="noreferrer">Canal de Telegram</a><button onClick={() => onNavigate('publicar')}>Acceso fundación</button></div>
      </div>
      <div className="shell footer-bottom">© 2026 Fundación ASISCO UP <span>Información pública y accesible para nuestra comunidad.</span></div>
    </footer>
  );
}

export default function App() {
  const [page, setPage] = useState<Page>('inicio');
  const navigate = (next: Page) => { setPage(next); window.scrollTo({ top: 0, behavior: 'smooth' }); };
  return (
    <div className="app">
      <Header page={page} onNavigate={navigate} />
      {page === 'inicio' && <Home onNavigate={navigate} />}
      {page === 'noticia' && <><ArticlePage /><Footer onNavigate={navigate} /></>}
      {page === 'agenda' && <><AgendaPage /><Footer onNavigate={navigate} /></>}
      {page === 'proyectos' && <><ProjectsPage /><Footer onNavigate={navigate} /></>}
      {page === 'nosotros' && <><AboutPage /><Footer onNavigate={navigate} /></>}
      {page === 'publicar' && <PublishPage />}
      {page === 'login' && <LoginPage onBack={() => navigate('inicio')} />}
    </div>
  );
}
